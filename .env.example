# =============================================================
# clientroll — example environment configuration
# Copy to .env and fill in the blank (secret) values.
# Non-secret defaults shown as-is; secrets were redacted.
# =============================================================

PORT=8085
ENVIRONMENT=production
DATABASE_URL=
REDIS_URL=
MASTER_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=https://clientroll.com
JWT_ACCESS_DURATION_MINUTES=60
JWT_REFRESH_DURATION_DAYS=7

MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=clientroll@app.businessnet.com
APP_URL=https://app.clientroll.com
SIGNUP_LINK_SIGNING_SECRET=
SIGNUP_LINKS_REQUIRE_SIGNATURE=true
SIGNUP_LINK_TTL_MINUTES=10080

# Xero OAuth (platform-level)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SYNC_ENABLED=true
XERO_CREDIT_NOTES_ENABLED=true
