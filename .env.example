# =============================================================
# clientroll — example environment configuration
# Copy to .env and fill in the blank (secret) values.
# Non-secret defaults shown as-is; secrets were redacted.
# =============================================================

PORT=8085
ENVIRONMENT=production
DATABASE_URL=
REDIS_URL=
MASTER_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_ACCESS_DURATION_MINUTES=60
JWT_REFRESH_DURATION_DAYS=7

MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=noreply@example.com
APP_URL=http://localhost:3000
SIGNUP_LINK_SIGNING_SECRET=
SIGNUP_LINKS_REQUIRE_SIGNATURE=true
# Signup links are permanent (they do not expire). SIGNUP_LINK_TTL_MINUTES is
# no longer used for expiry enforcement and is kept only for backwards compat.
SIGNUP_LINK_TTL_MINUTES=10080

# GoCardless Connect (platform-level; leave empty to disable GoCardless)
GOCARDLESS_SANDBOX_CLIENT_ID=
GOCARDLESS_SANDBOX_CLIENT_SECRET=
GOCARDLESS_LIVE_CLIENT_ID=
GOCARDLESS_LIVE_CLIENT_SECRET=
# Fallback when a tenant has no per-tenant webhook secret
GOCARDLESS_WEBHOOK_SECRET=

# Xero OAuth (platform-level)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Defaults to APP_URL + the Xero callback path when empty
XERO_REDIRECT_URI=
XERO_SYNC_ENABLED=true
XERO_CREDIT_NOTES_ENABLED=true

# Critical internal alerts are POSTed here as JSON (empty disables)
ALERTS_WEBHOOK_URL=
